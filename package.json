{
  "name": "novavix-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/security/scrub-standalone-secrets.js",
    "build:prod": "next build",
    "postbuild:prod": "node scripts/security/scrub-standalone-secrets.js",
    "start": "node -e \"const {spawn}=require('node:child_process');const port=process.env.PORT||'3000';const host=process.env.HOSTNAME||'0.0.0.0';const bin=process.platform==='win32'?'npx.cmd':'npx';const p=spawn(bin,['next','start','-p',port,'-H',host],{stdio:'inherit',shell:false});p.on('exit',(c)=>process.exit(c??0));\"",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run security:scan-secrets",
    "security:scrub-build": "node scripts/security/scrub-standalone-secrets.js",
    "security:scan-secrets": "node scripts/security/scan-secret-exposure.js",
    "admin:create-person": "node scripts/admin-create-person.js",
    "admin:reset-password": "node scripts/admin-reset-password.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.1.0",
    "@supabase/supabase-js": "^2.39.7",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.3",
    "csv-parse": "^6.2.1",
    "lucide-react": "^0.344.0",
    "mongodb": "^7.1.1",
    "next": "^14.2.35",
    "next-sanity": "^8.1.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-is": ">=18.2.0 <20",
    "resend": "^6.12.2",
    "sanity": "^3.30.0",
    "styled-components": "^6.3.12",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3"
  }
}
