# Publicas, embutidas no bundle do navegador
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=

# Privadas: nunca usar prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
MONGODB_URI=
MONGODB_DB_NAME=

# E-mail transacional. O envio de convites atual usa Resend em producao.
RESEND_API_KEY=
EMAIL_FROM=
# Reservado para uma futura implementacao SMTP; nao substitui RESEND_API_KEY hoje.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Compatibilidade com provedores Gmail via SMTP, se adotado no deploy.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Aplicacao e CORS
FRONTEND_URL=
PORT=3000

# Chaves privadas de integracao
NOVAVIX_SYNC_API_KEY=
NOVAVIX_COPSOQ_API_KEY=

# COPSOQ e rate limit
NOVAVIX_COPSOQ_TECHNICAL_EMAILS=
NOVAVIX_COPSOQ_MIN_GROUP_RESPONDENTS=5
NOVAVIX_RATE_LIMIT_MAX_KEYS=10000
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Convites
FORM_EMAIL_INVITE_DEDUP_MINUTES=5
FORM_INVITE_DEDUP_WINDOW_MS=300000
